# Secrets — never commit. §0 forbids credentials in source or history.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Runtime artefacts
data/snapshots/
*.log

# Ad-hoc report runs stay local; the dated evidence records in reports/evidence/ are
# committed deliberately -- they are the artefacts the submission is scored on.
reports/*.json
!reports/.gitkeep
!reports/evidence/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Own-feed footage is data, not source.
data/own_feed/*
!data/own_feed/README.md
!data/own_feed/SOURCE.md

# Test fixtures are generated, not authored.
tests/fixtures/*.mp4

# Evidence: the signing key never leaves this machine, but the demo crops must be
# committed. They are the images the Journey and Alert screens render, and the
# Dockerfile copies `data/` into the image -- so a build from a local checkout picked
# them up off the filesystem and a build from GitHub did not. That difference is
# invisible locally and produces a deployed console with 4 hops and 0 images.
data/evidence/*
!data/evidence/crops/
data/evidence/crops/.gitkeep
data/evidence/signing_key*

# Frontend build output and deps
frontend/node_modules/
frontend/dist/

# TypeScript incremental build state. Machine-specific and regenerated on every
# build; tracking it produces a diff on every developer's first compile.
frontend/tsconfig.tsbuildinfo
frontend/*.tsbuildinfo

# Development-only evidence signing key. Never a production key.
data/evidence/signing_key.dev

# Ad-hoc detection reports; the dated evidence copies are committed.
reports/detections-*.csv
reports/detections-*.pdf

# Production secrets, generated locally.
.env.prod

# Draft demo recordings. Regenerated by `make record-demo`, tens of MB each, and
# superseded the moment the footage or the console changes -- the runbook script is
# the durable artefact, not its rendering.
docs/demo-recordings/

# Generated deployment secrets. Never committed.
deploy-secrets.env
