# Secrets — never commit. §0 forbids credentials in source or history.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Runtime artefacts
data/evidence/
data/snapshots/
*.log

# Ad-hoc report runs stay local; the dated evidence records in reports/evidence/ are
# committed deliberately -- they are the artefacts the submission is scored on.
reports/*.json
!reports/.gitkeep
!reports/evidence/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Own-feed footage is data, not source.
data/own_feed/*
!data/own_feed/README.md
!data/own_feed/SOURCE.md

# Test fixtures are generated, not authored.
tests/fixtures/*.mp4

# Evidence crops are runtime output, not source.
data/evidence/

# Frontend build output and deps
frontend/node_modules/
frontend/dist/

# TypeScript incremental build state. Machine-specific and regenerated on every
# build; tracking it produces a diff on every developer's first compile.
frontend/tsconfig.tsbuildinfo
frontend/*.tsbuildinfo

# Development-only evidence signing key. Never a production key.
data/evidence/signing_key.dev
