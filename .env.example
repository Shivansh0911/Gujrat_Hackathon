# Project SETU — copy to .env and fill. NEVER commit .env.
#
# The gateway host lives here and only here. A second gateway is added in Phase 2;
# keeping this in config makes that a deployment change, not a code change, which is
# what the vendor-neutrality claim in the HLD actually rests on.
SETU_GATEWAY_HOST=live.corp8.cloud
SETU_GATEWAY_SCHEME=https
SETU_GATEWAY_RTSP_PORT=8554
SETU_GATEWAY_WHEP_PORT=8889

# tcp | udp. TCP is the default and the only supported value for evaluation:
# UDP fails across NAT/corporate firewalls and partial delivery yields corrupt
# frames that present as model bugs. Kept as a flag so we can *demonstrate* the
# difference to the jury, not so we can ship UDP.
SETU_RTSP_TRANSPORT=tcp

# Seconds to wait for the first decodable frame before declaring a camera down.
# Generous because decoder warnings at join are expected until the first IDR.
SETU_JOIN_TIMEOUT_S=20.0

# Reconnect backoff envelope (seconds).
SETU_BACKOFF_MIN_S=2.0
SETU_BACKOFF_MAX_S=30.0

# Cap on simultaneous upstream captures. Each connected client gets its own copy
# of the stream, so this is a politeness limit on the organiser's gateway as much
# as a resource limit on ours.
SETU_MAX_CONCURRENT_CAPTURES=6

# libav log level for the FFmpeg backend: 16=error, 24=warning, 32=info.
# Held at error so expected join-time RPS/POC warnings do not flood the console.
SETU_FFMPEG_LOGLEVEL=16

# --- Datastores (docker-compose) ---
POSTGRES_DB=setu
POSTGRES_USER=setu
POSTGRES_PASSWORD=change-me-locally
SETU_DATABASE_URL=postgresql+psycopg://setu:change-me-locally@127.0.0.1:5432/setu

REDIS_PASSWORD=change-me-locally

MINIO_ROOT_USER=setu-minio
MINIO_ROOT_PASSWORD=change-me-locally

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-locally

# --- API auth (T0.4 interim JWT; Keycloak/OIDC replaces this at T1.6) ---
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SETU_JWT_SECRET=change-me-locally
SETU_JWT_ISSUER=setu-local
SETU_ACCESS_TOKEN_TTL_MIN=30

# --- Evidence storage ---
SETU_EVIDENCE_DIR=data/evidence
